<?xml version="1.0" encoding="utf-8"?>
<!-- Кладётся рядом с own-tube.exe. .NET Framework (его использует окно на WebView2 через pythonnet) по умолчанию
     отказывается загружать сборки с пометкой «получено из интернета» (Zone.Identifier) — так бывает после распаковки
     скачанного zip проводником Windows. Разрешаем загрузку: файлы лежат в папке программы, а подлинность архива
     проверена SHA-256. Дополнительно программа снимает такие пометки при запуске (owntube/motw.py). -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
